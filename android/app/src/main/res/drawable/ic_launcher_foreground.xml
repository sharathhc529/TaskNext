<?xml version="1.0" encoding="utf-8"?>
<!-- "Solar" progress ring: countdown ring closing on a check, with a glowing head where the ring ends.
     Artwork stays inside the 66dp adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Track -->
    <path
        android:pathData="M54,30 a24,24 0 1,1 0,48 a24,24 0 1,1 0,-48z"
        android:strokeColor="#24FFFFFF"
        android:strokeWidth="8" />
    <!-- Progress (three quarters, clockwise from the top) -->
    <path
        android:pathData="M54,30 A24,24 0 1,1 30,54"
        android:strokeWidth="8"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="30"
                android:startY="30"
                android:endX="78"
                android:endY="78">
                <item android:offset="0" android:color="#FFFDE047" />
                <item android:offset="1" android:color="#FFFB923C" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Glowing head -->
    <path
        android:fillColor="#59FB923C"
        android:pathData="M30,47 a7,7 0 1,1 0,14 a7,7 0 1,1 0,-14z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M30,50.8 a3.2,3.2 0 1,1 0,6.4 a3.2,3.2 0 1,1 0,-6.4z" />
    <!-- Check -->
    <path
        android:pathData="M44,54.5 L51,61.5 L64.5,47"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
